rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only authenticated users can create/read/update/delete their own user document.
    match /users/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Add other collections here with rules specific to your app.
    // Example: allow public reading of a movies collection, but only admins can write.
    // match /movies/{movieId} {
    //   allow read: if true;
    //   allow write: if request.auth != null && request.auth.token.admin == true;
    // }
  }
}
